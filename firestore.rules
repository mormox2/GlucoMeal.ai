rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Fonctions globales de sécurité ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDelegate(userId) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(userId)/delegates/$(request.auth.uid));
    }

    function canReadPatient(userId) {
      return isOwner(userId) || isDelegate(userId);
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Validation du profil utilisateur ---
    function isValidUserProfile(data, userId) {
      return data.userId == userId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (data.glucoseUnit == 'g/L' || data.glucoseUnit == 'mg/dL')
        && data.targetGlucose is number && data.targetGlucose > 0
        && data.isf is number && data.isf > 0;
    }

    // --- Validation d'un enregistrement repas ---
    function isValidMeal(data, userId) {
      return data.userId == userId
        && data.meal_name is string && data.meal_name.size() > 0 && data.meal_name.size() <= 250
        && data.total_carbs is number && data.total_carbs >= 0 && data.total_carbs <= 1000
        && (
          ('created_at' in data && data.created_at is string) ||
          ('timestamp' in data && data.timestamp is string)
        );
    }

    // Profil utilisateur patient
    match /users/{userId} {
      allow get: if canReadPatient(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Repas et calculs de bolus
      match /meals/{mealId} {
        allow get, list: if canReadPatient(userId);
        allow create: if isOwner(userId) && isValidId(mealId) && isValidMeal(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(mealId) && isValidMeal(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(mealId);
      }

      // Configuration et snapshots CGM
      match /cgm/{cgmDocId} {
        allow get, list: if canReadPatient(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(cgmDocId);
      }

      // Délégations d'accès pour médecins et soignants (accès révocable)
      match /delegates/{delegateId} {
        allow get, list: if isOwner(userId) || (isSignedIn() && request.auth.uid == delegateId);
        allow create, update, delete: if isOwner(userId) && isValidId(delegateId);
      }
    }

    // Codes de transfert inter-appareils (80 bits aléatoires, ex: GLUCO-7K2X-9B4F-QM3T-H8WZ)
    function isValidSyncCode(code) {
      return code is string && code.matches('^GLUCO(-[A-HJ-NP-Z2-9]{4}){4}$');
    }

    function isValidSyncRecord(code) {
      return incoming().syncCode == code
        && incoming().creatorUid == request.auth.uid
        && incoming().userProfile is map
        && !('cgmConfig' in incoming().userProfile)
        && incoming().meals is list
        && incoming().expiresAt is timestamp
        && incoming().expiresAt > request.time
        && incoming().expiresAt < request.time + duration.value(8, 'd');
    }

    match /syncCodes/{code} {
      // Lecture par toute personne connectée qui connaît le code, tant qu'il n'a pas expiré
      allow get: if isSignedIn() && isValidSyncCode(code)
        && resource.data.expiresAt is timestamp
        && request.time < resource.data.expiresAt;
      // Création : le document est lié au compte qui le crée
      allow create: if isSignedIn() && isValidSyncCode(code) && isValidSyncRecord(code);
      // Mise à jour et suppression : uniquement par le compte créateur
      allow update: if isSignedIn() && resource.data.creatorUid == request.auth.uid && isValidSyncRecord(code);
      allow delete: if isSignedIn() && resource.data.creatorUid == request.auth.uid;
    }

    // Interdiction stricte de toute autre collection non déclarée
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
