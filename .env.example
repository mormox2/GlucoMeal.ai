# GEMINI_API_KEY : clé API Google Gemini (fournisseur principal pour l'analyse photo, texte et étiquettes).
# Sans elle, l'analyse texte utilise l'analyseur local et l'analyse photo est indisponible.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL : modèle principal (défaut gemini-2.5-flash).
# GEMINI_FALLBACK_MODEL : modèle de repli essayé si le principal échoue (aucun par défaut).
# GEMINI_TIMEOUT_MS : délai maximal d'un appel Gemini en millisecondes (défaut 25000).
GEMINI_MODEL=""
GEMINI_FALLBACK_MODEL=""
GEMINI_TIMEOUT_MS=""

# Relais IA compatible OpenAI, utilisé pour la photo, le texte et les étiquettes quand Gemini est
# indisponible (quota épuisé, panne, délai dépassé). Peut aussi être utilisé seul, sans clé Gemini.
# AI_RELAY_API_KEY : clé du service (par défaut NVIDIA NIM : build.nvidia.com > Get API Key, « nvapi-… »).
# AI_RELAY_BASE_URL : URL de l'API (défaut https://integrate.api.nvidia.com/v1 ;
#   OpenRouter : https://openrouter.ai/api/v1 ; Groq : https://api.groq.com/openai/v1).
# AI_RELAY_MODEL : modèle capable de lire les images (défaut meta/llama-3.2-90b-vision-instruct).
# AI_RELAY_JSON_MODE : none (défaut, schéma dans les consignes), json_object ou json_schema (si le
#   service les accepte).
# AI_RELAY_TIMEOUT_MS : délai maximal d'un appel en millisecondes (défaut 25000).
# Changer de service impose de mettre à jour la politique de confidentialité (destinataire des repas).
AI_RELAY_API_KEY=""
AI_RELAY_BASE_URL=""
AI_RELAY_MODEL=""
AI_RELAY_JSON_MODE=""
AI_RELAY_TIMEOUT_MS=""

# APP_URL : URL canonique de l'application (ex. http://localhost:3000 en local).
APP_URL="http://localhost:3000"

# PORT : port du serveur local (défaut 3000).
PORT=3000

# ALLOWED_ORIGINS : origines autorisées par CORS, séparées par des virgules
# (défaut https://glucomeal-ai.vercel.app ; le même hôte est toujours autorisé).
ALLOWED_ORIGINS=""

# TRUST_PROXY : nombre de proxys de confiance devant le serveur, pour l'IP du limiteur de requêtes
# (défaut 1 sur Vercel, désactivé ailleurs).
TRUST_PROXY=""

# VITE_SUPABASE_URL et VITE_SUPABASE_PUBLISHABLE_KEY : projet Supabase utilisé pour les comptes
# et la sauvegarde cloud (tableau de bord Supabase > Project Settings > API Keys ; l'ancienne clé
# « anon » fonctionne aussi). Ces valeurs sont publiques : la sécurité repose sur les politiques RLS.
# Sans elles, l'application fonctionne en mode 100 % local (sans compte ni sauvegarde cloud).
# En local avec « npx supabase start » : URL http://127.0.0.1:54321 et clé « Publishable » affichée.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
