# GEMINI_API_KEY : clé API Google Gemini (obligatoire pour l'analyse photo, texte et étiquettes).
# Sans elle, l'analyse texte utilise l'analyseur local et l'analyse photo est indisponible.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL : modèle principal (défaut gemini-2.5-flash).
# GEMINI_FALLBACK_MODEL : modèle de repli essayé si le principal échoue (aucun par défaut).
# GEMINI_TIMEOUT_MS : délai maximal d'un appel Gemini en millisecondes (défaut 25000).
GEMINI_MODEL=""
GEMINI_FALLBACK_MODEL=""
GEMINI_TIMEOUT_MS=""

# APP_URL : URL canonique de l'application (ex. http://localhost:3000 en local).
APP_URL="http://localhost:3000"

# PORT : port du serveur local (défaut 3000).
PORT=3000

# ALLOWED_ORIGINS : origines autorisées par CORS, séparées par des virgules
# (défaut https://glucomeal-ai.vercel.app ; le même hôte est toujours autorisé).
ALLOWED_ORIGINS=""

# TRUST_PROXY : nombre de proxys de confiance devant le serveur, pour l'IP du limiteur de requêtes
# (défaut 1 sur Vercel, désactivé ailleurs).
TRUST_PROXY=""

# VITE_SUPABASE_URL et VITE_SUPABASE_PUBLISHABLE_KEY : projet Supabase utilisé pour les comptes
# et la sauvegarde cloud (tableau de bord Supabase > Project Settings > API Keys ; l'ancienne clé
# « anon » fonctionne aussi). Ces valeurs sont publiques : la sécurité repose sur les politiques RLS.
# Sans elles, l'application fonctionne en mode 100 % local (sans compte ni sauvegarde cloud).
# En local avec « npx supabase start » : URL http://127.0.0.1:54321 et clé « Publishable » affichée.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
