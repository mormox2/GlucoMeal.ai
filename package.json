{
  "name": "glucomeal-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:api",
    "start": "tsx server.ts",
    "test": "vitest run",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "build:icons": "node scripts/build-favicons.mjs",
    "build:api": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js --banner:js=\"// Fichier généré par « npm run build:api » à partir de server.ts : ne pas modifier à la main.\"",
    "test:rules": "npx -y firebase-tools@13 emulators:exec --only firestore,storage --project demo-glucomeal \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@vercel/analytics": "^2.0.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
